# ========================================================
# LexMonitor Yucatán — Plantilla de Variables de Entorno
# Copia este archivo como .env y completa tus credenciales.
# ========================================================

# Configuración del Servidor
PORT=5000
DATABASE_URL=sqlite:///lexmonitor.db

# Configuración Global de Telegram Bot (Token obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=tu_bot_token_de_telegram_aqui

# Configuración de Correo vía Resend API (Recomendado para Render en la nube - Puerto 443 HTTPS)
# Obtén tu clave gratuita en: https://resend.com
RESEND_API_KEY=re_tu_api_key_aqui
RESEND_FROM_EMAIL=LexMonitor Yucatán <onboarding@resend.dev>

# Configuración por defecto de Correo SMTP tradicional (Gmail / Outlook)
# Para Gmail, genera una contraseña de 16 caracteres en: myaccount.google.com/apppasswords
DEFAULT_SMTP_SENDER_EMAIL=tu_correo_remitente@gmail.com
DEFAULT_SMTP_SENDER_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=465
DEFAULT_SMTP_USE_SSL=true

# Clave Secreta para ejecución de Cron Diario externo (cron-job.org / GitHub Actions)
CRON_SECRET=lex_cron_2026_secreto1234542

